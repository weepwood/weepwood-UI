{
  "name": "weepwood-ui-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @weepwood/storybook dev",
    "dev:playground": "pnpm build:lib && pnpm --filter @weepwood/playground dev",
    "build:lib": "pnpm --filter @weepwood/ui-vue build",
    "build:playground": "pnpm build:lib && pnpm --filter @weepwood/playground build",
    "build:storybook": "pnpm --filter @weepwood/storybook build",
    "typecheck": "pnpm build:lib && pnpm --filter @weepwood/ui-vue typecheck && pnpm --filter @weepwood/playground typecheck",
    "test": "pnpm --filter @weepwood/ui-vue test",
    "check": "pnpm typecheck && pnpm test && pnpm build:playground && pnpm build:storybook"
  }
}
